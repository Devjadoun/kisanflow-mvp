# Obtain these credentials from your Supabase Dashboard:
# Project Settings -> API -> Project URL & Project API Keys (anon / public)
#
# IMPORTANT:
# - Use ONLY the public anon key (VITE_SUPABASE_ANON_KEY).
# - NEVER expose the service_role key in frontend browser code.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key-here
